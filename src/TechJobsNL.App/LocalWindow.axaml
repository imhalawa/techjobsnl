<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:TechJobsNL.App.Browsing"
        xmlns:v="clr-namespace:TechJobsNL.Core.Vacancies;assembly=TechJobsNL.Core"
        x:Class="TechJobsNL.App.LocalWindow" x:DataType="b:LocalWindowViewModel"
        Title="TechJobsNL" Width="1000" Height="700" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
    <StackPanel Spacing="8" Margin="0,0,0,24">
      <TextBlock Text="Vacancies" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Browse vacancies retained on this device." TextWrapping="Wrap" />
      <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search title or company"
               AutomationProperties.Name="Search title or company" Margin="0,8,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="8">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding State.IsLoading}" Margin="0,0,0,16" />
      <TextBlock x:Name="ErrorMessage" Text="{Binding State.Message}" IsVisible="{Binding State.IsFailed}" TextWrapping="Wrap" Margin="0,0,0,16" />
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="2*,24,3*">
      <Grid>
      <TextBlock x:Name="StateMessage" Text="{Binding State.Message}" TextWrapping="Wrap"
                 IsVisible="{Binding State.ShowStatusMessage}" VerticalAlignment="Center" HorizontalAlignment="Center" />
      <ListBox x:Name="VacancyList" ItemsSource="{Binding State.Vacancies}" IsVisible="{Binding State.HasVacancies}"
               SelectedItem="{Binding SelectedVacancy, Mode=TwoWay}"
               AutomationProperties.Name="Retained vacancies">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="v:RetainedVacancy">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding CompanyName}" />
          </Style>
          <Style Selector="ListBoxItem:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="v:RetainedVacancy">
            <StackPanel Spacing="4" Margin="8,10">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CompanyName}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </Grid>
      <Grid Grid.Column="2">
        <TextBlock x:Name="EmptySelection" Text="Select a vacancy to view its details." TextWrapping="Wrap"
                   IsVisible="{Binding !HasSelection}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <ScrollViewer x:Name="DetailPane" IsVisible="{Binding HasSelection}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,0,12,0">
            <TextBlock x:Name="DetailTitle" Text="{Binding SelectedVacancy.Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailCompany" Text="{Binding SelectedVacancy.CompanyName}" TextWrapping="Wrap" />
            <TextBlock Text="Official vacancy URL" FontWeight="SemiBold" Margin="0,8,0,0" />
            <SelectableTextBlock x:Name="DetailUrl" Text="{Binding SelectedVacancy.JobUrl}" TextWrapping="Wrap" />
            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,8,0,0" />
            <SelectableTextBlock x:Name="DetailDescription" Text="{Binding SelectedVacancy.Description}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" Text="Local data · available offline" Margin="0,16,0,0" FontSize="12" />
  </Grid>
</Window>
