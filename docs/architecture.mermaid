%% Projects present in the current solution; future delivery remains in the private Project.
flowchart TB
    subgraph src["src"]
        App["TechJobsNL.App<br/>desktop host and presentation"]
        Runtime["TechJobsNL.Runtime<br/>startup · configuration · composition"]
        Core["TechJobsNL.Core<br/>domain · dispatch · queries · scanning · ports"]
        Providers["TechJobsNL.Adapters.Providers<br/>safe HTTP · source normalization"]
        Sqlite["TechJobsNL.Persistence.Sqlite<br/>compatible persistence · recovery · local reads"]
        App --> Runtime
        Runtime --> Core
        Runtime --> Providers
        Runtime --> Sqlite
        Providers --> Core
        Sqlite --> Core
    end
    subgraph tests["tests"]
        AppTests["TechJobsNL.App.Tests"]
        RuntimeTests["TechJobsNL.Runtime.Tests"]
        CoreTests["TechJobsNL.Core.Tests"]
        ProviderTests["TechJobsNL.Adapters.Providers.Tests"]
        SqliteTests["TechJobsNL.Persistence.Sqlite.Tests"]
    end
    AppTests -.-> App
    RuntimeTests -.-> Runtime
    CoreTests -.-> Core
    ProviderTests -.-> Providers
    SqliteTests -.-> Sqlite
